pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/krushnadeshmukh7/student-management.git'

                echo "Cloning is successful"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                    fingerprint: true
                }
            }
        }

        stage('Upload to S3') {
            steps {
                sh 'aws s3 cp target/*.war s3://krushna.online1234/'
            }
        }

    }
}