pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Poonam-Dev77/student-management.git'

                echo "Cloning is successful"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                    fingerprint: true
                }
            }
        }

