pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }
     environment {
        AWS_DEFAULT_REGION = 'ap-southeast-1'
    }
    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Poonam-Dev77/student-management.git'

                echo "Cloning is successful"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                    fingerprint: true
                }
            }
        }

        stage('Upload to S3') {
            steps {
                sh '''
                    aws s3 cp target/student-management.war s3://deploywithpoonam.spaace/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build --no-cache -t student .
                    docker images
                '''
            }
        }
        stage('Push to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ap-southeast-1 | docker login --username AWS --password-stdin 172030246609.dkr.ecr.ap-southeast-1.amazonaws.com

                docker tag student:latest 172030246609.dkr.ecr.ap-southeast-1.amazonaws.com/student:latest

                docker push 172030246609.dkr.ecr.ap-southeast-1.amazonaws.com/student:latest
                '''
            } 
        }      
    }
}